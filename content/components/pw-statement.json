{
  "name": "pw-statement",
  "label": "Statement section (The Pattern)",
  "description": "A serif statement section: small label, accent rule, headline, a larger serif subhead, two columns of paragraphs and an italic closing line. Used for The Pattern.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "closing": {
      "kind": "text",
      "label": "Italic closing line",
      "optional": true,
      "maxLength": 160
    },
    "closingSize": {
      "kind": "select",
      "label": "Closing line size",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "display": "segmented"
    },
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Obsidian (near black)"
        },
        {
          "value": "bone",
          "label": "Bone (light)"
        },
        {
          "value": "umber",
          "label": "Umber (warm charcoal)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "olive",
          "label": "Olive (deep green)"
        }
      ],
      "display": "dropdown"
    },
    "headline": {
      "kind": "text",
      "label": "Section headline",
      "help": "Keep under 12 words.",
      "maxLength": 140
    },
    "headlineSize": {
      "kind": "select",
      "label": "Headline size",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "display": "segmented"
    },
    "kicker": {
      "kind": "text",
      "label": "Small label above the headline",
      "optional": true,
      "maxLength": 60
    },
    "paragraphs": {
      "kind": "list",
      "label": "Paragraphs",
      "fields": {
        "text": {
          "kind": "text",
          "label": "Paragraph",
          "maxLength": 700,
          "multiline": true
        }
      },
      "min": 0,
      "max": 6,
      "itemLabel": "text"
    },
    "subhead": {
      "kind": "text",
      "label": "Larger line under the headline",
      "optional": true,
      "maxLength": 320,
      "multiline": true
    },
    "width": {
      "kind": "select",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "content",
          "label": "Wide"
        }
      ],
      "display": "segmented"
    }
  },
  "defaults": {
    "closing": "Power With makes the pattern visible while it can still change.",
    "closingSize": "standard",
    "ground": "oxblood",
    "headline": "The drive that builds companies can dismantle marriages.",
    "headlineSize": "standard",
    "kicker": "THE PATTERN",
    "paragraphs": [
      {
        "text": "Most people treat their success and their relational struggles as separate problems. The career is going well. The marriage is hard. Both run on the same operating system."
      },
      {
        "text": "The strategies that win in competition are specific. Control, self-sufficiency, the refusal to be affected, the need to stay ahead. At home and on a team, those same strategies create distance. The cost builds so slowly that most people see it only once it runs deep."
      }
    ],
    "subhead": "The control that commands respect can silence the people who love you most. The armor that makes you formidable can make you unreachable.",
    "width": "narrow"
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\" data-width=\"{{width}}\">\n<div class=\"pw__in\">\n{{#if kicker}}<p class=\"pw__kicker\">{{kicker}}</p>{{/if}}\n<div class=\"pw__rule\"></div>\n<h2 class=\"pw__h2\" data-size=\"{{headlineSize}}\">{{headline}}</h2>\n{{#if subhead}}<p class=\"pw__sub\">{{subhead}}</p>{{/if}}\n{{#if paragraphs}}<div class=\"pw__cols\">{{#each paragraphs}}<p>{{text}}</p>{{/each}}</div>{{/if}}\n{{#if closing}}<p class=\"pw__close\" data-size=\"{{closingSize}}\">{{closing}}</p>{{/if}}\n</div>\n</div>",
  "css": ":scope{display:block;width:100%}\n.pw{--bg:#0F0E0C;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#8E4A30;--hl:#3A3531;background:var(--bg);color:var(--tx);font-family:var(--os-font-body);font-weight:400}\n.pw[data-ground=\"bone\"]{--bg:#EDE6D8;--tx:#0F0E0C;--lb:#3A3531;--rl:#8E4A30;--hl:#3A3531}\n.pw[data-ground=\"umber\"]{--bg:#3A3531;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#C2B8A6;--hl:#C2B8A6}\n.pw[data-ground=\"oxblood\"]{--bg:#4A1C18;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#C2B8A6;--hl:#C2B8A6}\n.pw[data-ground=\"clay\"]{--bg:#8E4A30;--tx:#EDE6D8;--lb:#EDE6D8;--rl:#EDE6D8;--hl:#EDE6D8}\n.pw[data-ground=\"olive\"]{--bg:#3C402F;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#C2B8A6;--hl:#C2B8A6}\n.pw__in{box-sizing:content-box;max-width:1000px;margin:0 auto;padding:112px 32px}\n.pw[data-width=\"content\"] .pw__in{max-width:1200px}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--lb)}\n.pw__rule{width:64px;height:2px;background:var(--rl);margin:28px 0 32px}\n.pw__in>.pw__rule:first-child{margin-top:0}\n.pw__h2{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:60px;line-height:1.08;color:var(--tx);text-wrap:balance}\n.pw__h2[data-size=\"large\"]{font-size:64px;line-height:1.05}\n.pw__sub{margin:28px 0 0;font-family:var(--os-font-heading);font-weight:500;font-size:30px;line-height:1.3;color:var(--tx)}\n.pw__cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;margin-top:56px}\n.pw__cols p{margin:0;font-size:21px;line-height:1.55}\n.pw__close{margin:48px 0 0;font-family:var(--os-font-heading);font-style:italic;font-weight:500;font-size:30px;line-height:normal;color:var(--tx)}\n.pw__close[data-size=\"large\"]{font-size:34px}\n@media (max-width:767px){\n.pw__in{padding:56px 20px}\n.pw__kicker{font-size:11px}\n.pw__rule{width:48px;margin:24px 0 24px}\n.pw__h2,.pw__h2[data-size=\"large\"]{font-size:40px;line-height:1.1}\n.pw__sub{font-size:23px;margin-top:20px}\n.pw__cols{grid-template-columns:1fr;gap:20px;margin-top:32px}\n.pw__cols p{font-size:19px}\n.pw__close,.pw__close[data-size=\"large\"]{font-size:27px;margin-top:36px}\n}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  }
}
