{
  "name": "pw-endorsements",
  "label": "Praise (strip or grid)",
  "description": "Endorsements shown either as a one-line praise strip or as a grid of quotes with names. Built hidden until real endorsements exist.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Obsidian (near black)"
        },
        {
          "value": "bone",
          "label": "Bone (light)"
        },
        {
          "value": "umber",
          "label": "Umber (warm charcoal)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "olive",
          "label": "Olive (deep green)"
        }
      ],
      "display": "dropdown"
    },
    "items": {
      "kind": "list",
      "label": "Endorsements",
      "fields": {
        "name": {
          "kind": "text",
          "label": "Name",
          "maxLength": 60
        },
        "quote": {
          "kind": "text",
          "label": "Quote",
          "maxLength": 300,
          "multiline": true
        },
        "title": {
          "kind": "text",
          "label": "Title or credential",
          "optional": true,
          "maxLength": 80
        }
      },
      "min": 1,
      "max": 6,
      "itemLabel": "name"
    },
    "kicker": {
      "kind": "text",
      "label": "Small label (grid only)",
      "optional": true,
      "maxLength": 60
    },
    "layout": {
      "kind": "select",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid of quotes"
        },
        {
          "value": "strip",
          "label": "One-line strip"
        }
      ],
      "display": "segmented"
    }
  },
  "defaults": {
    "ground": "obsidian",
    "items": [
      {
        "name": "[NAME]",
        "quote": "[Endorsement from a recognized author on leadership or relationships.]",
        "title": "[BOOK OR TITLE]"
      },
      {
        "name": "[NAME]",
        "quote": "[Endorsement from an executive or founder who has read an advance copy.]",
        "title": "[TITLE, COMPANY]"
      },
      {
        "name": "[NAME]",
        "quote": "[Endorsement from a clinician or coach.]",
        "title": "[CREDENTIAL]"
      }
    ],
    "kicker": "PRAISE FOR POWER WITH",
    "layout": "grid"
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\" data-layout=\"{{layout}}\"><div class=\"pw__in\">{{#if kicker}}<p class=\"pw__kicker\">{{kicker}}</p>{{/if}}<div class=\"pw__rule\"></div><div class=\"pw__grid\">{{#each items}}<figure class=\"pw__fig\"><blockquote class=\"pw__q\">{{quote}}</blockquote><figcaption class=\"pw__by\">{{name}}{{#if title}} · {{title}}{{/if}}</figcaption></figure>{{/each}}</div></div></div>",
  "css": ":scope{display:block;width:100%}.pw{--bg:#0F0E0C;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#8E4A30;background:var(--bg);color:var(--tx);font-family:var(--os-font-body);font-weight:400}.pw[data-ground=\"bone\"]{--bg:#EDE6D8;--tx:#0F0E0C;--lb:#3A3531;--rl:#8E4A30}.pw[data-ground=\"umber\"]{--bg:#3A3531;--rl:#C2B8A6}.pw[data-ground=\"oxblood\"]{--bg:#4A1C18;--rl:#C2B8A6}.pw[data-ground=\"clay\"]{--bg:#8E4A30;--lb:#EDE6D8;--rl:#EDE6D8}.pw[data-ground=\"olive\"]{--bg:#3C402F;--rl:#C2B8A6}\n.pw__in{box-sizing:content-box;max-width:1200px;margin:0 auto;padding:112px 32px}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--lb)}\n.pw__rule{width:64px;height:2px;background:var(--rl);margin:28px 0 48px}\n.pw__in>.pw__rule:first-child{margin-top:0}\n.pw__grid{display:grid;gap:48px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}\n.pw__fig{margin:0}\n.pw__q{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:28px;line-height:1.3}\n.pw__by{margin-top:20px;font-family:var(--os-font-label);font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--lb)}\n.pw[data-layout=\"strip\"] .pw__in{padding:36px 32px}\n.pw[data-layout=\"strip\"] .pw__kicker,.pw[data-layout=\"strip\"] .pw__rule{display:none}\n.pw[data-layout=\"strip\"] .pw__grid{display:flex;flex-direction:column;gap:16px}\n.pw[data-layout=\"strip\"] .pw__fig{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px}\n.pw[data-layout=\"strip\"] .pw__q{flex:999 1 480px;font-size:26px}\n.pw[data-layout=\"strip\"] .pw__by{margin-top:0;font-size:11px}\n.pw[data-layout=\"strip\"] .pw__fig:nth-child(n+2){display:none}\n@media (max-width:767px){.pw__in{padding:56px 20px}.pw__kicker{font-size:11px}.pw__rule{width:48px;margin:24px 0 32px}.pw__grid{grid-template-columns:1fr;gap:36px}.pw__q{font-size:24px}.pw[data-layout=\"strip\"] .pw__in{padding:28px 20px}.pw[data-layout=\"strip\"] .pw__q{font-size:21px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Endorsements as a strip or grid.",
    "whenToUse": "Praise from named people."
  }
}
