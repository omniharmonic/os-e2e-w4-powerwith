{
  "name": "pw-sticky-bar",
  "label": "Sticky bar (phones only)",
  "description": "A bar fixed to the bottom of the screen on phones with a short label and a button. Hidden on tablets and desktops.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "buttonLabel": {
      "kind": "text",
      "label": "Button text",
      "maxLength": 30
    },
    "buttonLink": {
      "kind": "link",
      "label": "Where the button goes"
    },
    "label": {
      "kind": "text",
      "label": "Label",
      "maxLength": 40
    }
  },
  "defaults": {
    "buttonLabel": "GET THE INTRODUCTION",
    "buttonLink": {
      "anchor": "introduction",
      "page": "pg_eq7h19rjgt",
      "type": "page"
    },
    "label": "FREE · THE INTRODUCTION"
  },
  "template": "<div class=\"pw\"><span class=\"pw__l\">{{label}}</span><a class=\"pw__b\" href=\"{{href buttonLink}}\">{{buttonLabel}}</a></div>",
  "css": ":scope{display:block;width:100%}.pw{display:none}\n@media (max-width:767px){.pw{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:50;background:#0F0E0C;border-top:1px solid #3A3531;padding:14px 20px;align-items:center;justify-content:space-between;gap:12px}.pw__l{font-family:var(--os-font-label);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#C2B8A6;line-height:1.3}.pw__b{font-family:var(--os-font-label);font-size:12px;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;color:#EDE6D8;background:#8E4A30;padding:15px 18px;white-space:nowrap}.pw__b:focus-visible{outline:2px solid #EDE6D8;outline-offset:2px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Phone-only sticky call to action.",
    "whenToUse": "Home page on phones."
  }
}
