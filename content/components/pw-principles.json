{
  "name": "pw-principles",
  "label": "Principle grid (ten icons)",
  "description": "Section with label, rule, headline, intro, a grid of principles (icon, number, name, one line) and an italic closing line. Icons are the wireframe sketches until the brand-kit SVGs are uploaded per item.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "closing": {
      "kind": "text",
      "label": "Italic closing line",
      "optional": true,
      "maxLength": 160
    },
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Obsidian (near black)"
        },
        {
          "value": "bone",
          "label": "Bone (light)"
        },
        {
          "value": "umber",
          "label": "Umber (warm charcoal)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "olive",
          "label": "Olive (deep green)"
        }
      ],
      "display": "dropdown"
    },
    "headline": {
      "kind": "text",
      "label": "Section headline",
      "maxLength": 140
    },
    "intro": {
      "kind": "text",
      "label": "Introduction",
      "optional": true,
      "maxLength": 320,
      "multiline": true
    },
    "items": {
      "kind": "list",
      "label": "Principles",
      "fields": {
        "customIcon": {
          "kind": "image",
          "label": "Or upload your own icon (SVG or PNG)",
          "optional": true
        },
        "icon": {
          "kind": "select",
          "label": "Icon sketch",
          "options": [
            {
              "value": "i1",
              "label": "01 Waves"
            },
            {
              "value": "i2",
              "label": "02 Overlap with small circle"
            },
            {
              "value": "i3",
              "label": "03 Arcs"
            },
            {
              "value": "i4",
              "label": "04 Circle over a line"
            },
            {
              "value": "i5",
              "label": "05 Eye"
            },
            {
              "value": "i6",
              "label": "06 Three circles"
            },
            {
              "value": "i7",
              "label": "07 Split circle"
            },
            {
              "value": "i8",
              "label": "08 Two circles"
            },
            {
              "value": "i9",
              "label": "09 Circle and spiral arc"
            },
            {
              "value": "i10",
              "label": "10 Return arrow"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "display": "dropdown"
        },
        "line": {
          "kind": "text",
          "label": "One line",
          "maxLength": 120
        },
        "name": {
          "kind": "text",
          "label": "Name",
          "maxLength": 40
        },
        "number": {
          "kind": "text",
          "label": "Number",
          "maxLength": 4
        }
      },
      "min": 1,
      "max": 12,
      "itemLabel": "name"
    },
    "kicker": {
      "kind": "text",
      "label": "Small label above the headline",
      "optional": true,
      "maxLength": 60
    }
  },
  "defaults": {
    "closing": "Each return is the practice.",
    "ground": "umber",
    "headline": "Ten capacities make power with possible.",
    "intro": "Each principle is a practice. Each one closes with a single action you can begin today. Together they build the capacity to stay connected under pressure.",
    "items": [
      {
        "icon": "i1",
        "line": "Staying present through discomfort.",
        "name": "EMOTIONAL REGULATION",
        "number": "01"
      },
      {
        "icon": "i2",
        "line": "Prioritizing another's experience when it matters most.",
        "name": "EMPATHY",
        "number": "02"
      },
      {
        "icon": "i3",
        "line": "Receiving another person's world.",
        "name": "LISTENING",
        "number": "03"
      },
      {
        "icon": "i4",
        "line": "Remaining teachable while staying yourself.",
        "name": "HUMILITY",
        "number": "04"
      },
      {
        "icon": "i5",
        "line": "Holding more than one perspective.",
        "name": "UNDERSTANDING",
        "number": "05"
      },
      {
        "icon": "i6",
        "line": "Transforming control into connection.",
        "name": "RELATIONALITY",
        "number": "06"
      },
      {
        "icon": "i7",
        "line": "Aligning word, action and energy.",
        "name": "INTEGRITY",
        "number": "07"
      },
      {
        "icon": "i8",
        "line": "Building safety through consistency, transparency and care.",
        "name": "TRUST",
        "number": "08"
      },
      {
        "icon": "i9",
        "line": "Owning your impact.",
        "name": "RESPONSIBILITY",
        "number": "09"
      },
      {
        "icon": "i10",
        "line": "Coming back.",
        "name": "REPAIR",
        "number": "10"
      }
    ],
    "kicker": "THE TEN PRINCIPLES"
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\"><div class=\"pw__in\">{{#if kicker}}<p class=\"pw__kicker\">{{kicker}}</p>{{/if}}<div class=\"pw__rule\"></div><h2 class=\"pw__h2\">{{headline}}</h2>{{#if intro}}<p class=\"pw__intro\">{{intro}}</p>{{/if}}<div class=\"pw__grid\">{{#each items}}<div class=\"pw__it\"><div class=\"pw__ic\" data-icon=\"{{icon}}\"><svg class=\"i1\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M8 16 Q16 8 24 16 T40 16\"></path><path d=\"M8 26 Q16 21 24 26 T40 26\"></path><line x1=\"8\" y1=\"36\" x2=\"40\" y2=\"36\"></line></svg><svg class=\"i2\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"19\" cy=\"24\" r=\"10\"></circle><circle cx=\"29\" cy=\"24\" r=\"10\"></circle><circle cx=\"24\" cy=\"24\" r=\"2.5\"></circle></svg><svg class=\"i3\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M22 13 A11 11 0 1 0 22 35\"></path><path d=\"M29 18 Q33 24 29 30\"></path><path d=\"M35 14 Q41 24 35 34\"></path></svg><svg class=\"i4\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"10\"></circle><line x1=\"8\" y1=\"34\" x2=\"40\" y2=\"34\"></line></svg><svg class=\"i5\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M8 24 Q24 10 40 24 Q24 38 8 24 Z\"></path><circle cx=\"24\" cy=\"24\" r=\"4\"></circle></svg><svg class=\"i6\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"19\" cy=\"20\" r=\"9\"></circle><circle cx=\"29\" cy=\"20\" r=\"9\"></circle><circle cx=\"24\" cy=\"29\" r=\"9\"></circle></svg><svg class=\"i7\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"12\"></circle><line x1=\"24\" y1=\"12\" x2=\"24\" y2=\"36\"></line></svg><svg class=\"i8\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"18\" cy=\"24\" r=\"9\"></circle><circle cx=\"30\" cy=\"24\" r=\"9\"></circle></svg><svg class=\"i9\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"1.8\" fill=\"currentColor\"></circle><circle cx=\"24\" cy=\"24\" r=\"8\"></circle><path d=\"M24 8 A16 16 0 1 1 10 32\"></path></svg><svg class=\"i10\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M31 13 A12 12 0 1 0 36 25\"></path><path d=\"M31 13 Q39 15 36 25\"></path><line x1=\"32\" y1=\"16\" x2=\"36\" y2=\"15\"></line><line x1=\"34\" y1=\"21\" x2=\"38\" y2=\"21\"></line></svg></div>{{#if customIcon}}<div class=\"pw__cic\">{{image customIcon sizes=\"96px\"}}</div>{{/if}}<p class=\"pw__nm\">{{number}} {{name}}</p><p class=\"pw__ln\">{{line}}</p></div>{{/each}}</div>{{#if closing}}<p class=\"pw__close\">{{closing}}</p>{{/if}}</div></div>",
  "css": ":scope{display:block;width:100%}.pw{--bg:#0F0E0C;--tx:#EDE6D8;--lb:#C2B8A6;--rl:#8E4A30;--hl:#3A3531;background:var(--bg);color:var(--tx);font-family:var(--os-font-body);font-weight:400}.pw[data-ground=\"bone\"]{--bg:#EDE6D8;--tx:#0F0E0C;--lb:#3A3531;--rl:#8E4A30;--hl:#3A3531}.pw[data-ground=\"umber\"]{--bg:#3A3531;--rl:#C2B8A6;--hl:#C2B8A6}.pw[data-ground=\"oxblood\"]{--bg:#4A1C18;--rl:#C2B8A6;--hl:#C2B8A6}.pw[data-ground=\"clay\"]{--bg:#8E4A30;--lb:#EDE6D8;--rl:#EDE6D8;--hl:#EDE6D8}.pw[data-ground=\"olive\"]{--bg:#3C402F;--rl:#C2B8A6;--hl:#C2B8A6}\n.pw__in{box-sizing:content-box;max-width:1200px;margin:0 auto;padding:112px 32px}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--lb)}\n.pw__rule{width:64px;height:2px;background:var(--rl);margin:28px 0 32px}\n.pw__in>.pw__rule:first-child{margin-top:0}\n.pw__h2{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:60px;line-height:1.08;color:var(--tx);text-wrap:balance}\n.pw__intro{margin:24px 0 0;font-size:21px;line-height:1.5;max-width:34em}\n.pw__grid{display:grid;gap:40px 32px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));margin-top:64px}\n.pw__ic{color:var(--lb);line-height:0}\n.pw__ic svg{display:none}\n.pw__ic[data-icon=\"i1\"] .i1,.pw__ic[data-icon=\"i2\"] .i2,.pw__ic[data-icon=\"i3\"] .i3,.pw__ic[data-icon=\"i4\"] .i4,.pw__ic[data-icon=\"i5\"] .i5,.pw__ic[data-icon=\"i6\"] .i6,.pw__ic[data-icon=\"i7\"] .i7,.pw__ic[data-icon=\"i8\"] .i8,.pw__ic[data-icon=\"i9\"] .i9,.pw__ic[data-icon=\"i10\"] .i10{display:block}\n.pw__ic[data-icon=\"none\"]{display:none}\n.pw__cic{line-height:0}.pw__cic img{display:block;width:48px;height:48px;object-fit:contain}\n.pw__nm{margin:16px 0 0;font-family:var(--os-font-label);font-weight:400;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--lb)}\n.pw__ln{margin:8px 0 0;font-size:19px;line-height:1.4}\n.pw__close{margin:64px 0 0;font-family:var(--os-font-heading);font-style:italic;font-weight:500;font-size:34px;line-height:normal}\n@media (max-width:767px){.pw__in{padding:56px 20px}.pw__kicker{font-size:11px}.pw__rule{width:48px;margin:24px 0}.pw__h2{font-size:40px;line-height:1.1}.pw__intro{font-size:19px;margin-top:20px}.pw__grid{grid-template-columns:1fr 1fr;gap:32px 20px;margin-top:36px}.pw__close{font-size:27px;margin-top:40px}}\n@media (max-width:420px){.pw__grid{grid-template-columns:1fr}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Grid of ten principles with icons.",
    "whenToUse": "A grid of short labelled items each with a small icon."
  }
}
