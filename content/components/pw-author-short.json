{
  "name": "pw-author-short",
  "label": "Short author block",
  "description": "Small portrait beside a label and one paragraph. Shows a placeholder until a portrait is uploaded.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "body": {
      "kind": "text",
      "label": "Text",
      "maxLength": 420,
      "multiline": true
    },
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Obsidian (near black)"
        },
        {
          "value": "bone",
          "label": "Bone (light)"
        },
        {
          "value": "umber",
          "label": "Umber (warm charcoal)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "olive",
          "label": "Olive (deep green)"
        }
      ],
      "display": "dropdown"
    },
    "label": {
      "kind": "text",
      "label": "Label",
      "maxLength": 60
    },
    "placeholder": {
      "kind": "text",
      "label": "Placeholder text",
      "optional": true,
      "maxLength": 40
    },
    "portrait": {
      "kind": "image",
      "label": "Portrait",
      "optional": true
    }
  },
  "defaults": {
    "body": "Sophia Life is an author, coach and organizational consultant. Power With is the synthesis of more than a decade of study and lived practice.",
    "ground": "obsidian",
    "label": "SOPHIA LIFE",
    "placeholder": "[PORTRAIT]"
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\"><div class=\"pw__in\">{{#if portrait}}<div class=\"pw__pic\">{{image portrait sizes=\"200px\"}}</div>{{else}}<div class=\"pw__pic pw__ph\" role=\"img\" aria-label=\"Author portrait placeholder\">{{placeholder}}</div>{{/if}}<div class=\"pw__tx\"><p class=\"pw__kicker\">{{label}}</p><p class=\"pw__body\">{{body}}</p></div></div></div>",
  "css": ":scope{display:block;width:100%}.pw{--bg:#0F0E0C;--tx:#EDE6D8;--lb:#C2B8A6;background:var(--bg);color:var(--tx);font-family:var(--os-font-body)}.pw[data-ground=\"bone\"]{--bg:#EDE6D8;--tx:#0F0E0C;--lb:#3A3531}.pw[data-ground=\"umber\"]{--bg:#3A3531}.pw[data-ground=\"oxblood\"]{--bg:#4A1C18}.pw[data-ground=\"clay\"]{--bg:#8E4A30;--lb:#EDE6D8}.pw[data-ground=\"olive\"]{--bg:#3C402F}\n.pw__in{box-sizing:content-box;max-width:1100px;margin:0 auto;padding:96px 32px;display:flex;flex-wrap:wrap;gap:48px;align-items:center}\n.pw__pic{flex:0 0 200px;height:240px;overflow:hidden;line-height:0}.pw__pic img{display:block;width:100%;height:100%;object-fit:cover}\n.pw__ph{background:#3A3531;display:flex;align-items:center;justify-content:center;text-align:center;font-family:var(--os-font-label);font-size:10px;letter-spacing:.2em;color:#C2B8A6;line-height:normal}\n.pw__tx{flex:999 1 420px;min-width:0}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--lb)}\n.pw__body{margin:16px 0 0;font-size:21px;line-height:1.55}\n@media (max-width:767px){.pw__in{padding:56px 20px;gap:28px}.pw__kicker{font-size:11px}.pw__body{font-size:19px}.pw__tx{flex-basis:100%}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Short author block.",
    "whenToUse": "Landing pages."
  }
}
