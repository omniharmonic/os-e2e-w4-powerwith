        {
          "id": "blk_4831yc4m1g",
          "type": "component/pw-claim-text",
          "v": 1,
          "column": 0,
          "fields": {
            "body": "A companion for your first reading. Power With asks a great deal of its reader. The Orientation helps you take it in and keep it close.",
            "headline": "Pre-order and receive the Orientation.",
            "items": [
              {
                "text": "The framework on one page. Power, power over and power with."
              },
              {
                "text": "The ten principles at a glance, with the practice from each."
              },
              {
                "text": "How to read the book. Straight through once, then back to the principles one at a time."
              },
              {
                "text": "The five measures of success, set as a reflection to return to."
              },
              {
                "text": "The pause, the single practice beneath all ten."
              }
            ],
            "kicker": "PRE-ORDER GIFT",
            "listLabel": "INSIDE THE ORIENTATION"
          }
        },
        {
          "id": "blk_mxmj4xcfd5",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Order from any retailer, then enter your order number. The Orientation arrives by email."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_eyayps9eer",
          "type": "form",
          "v": 1,
