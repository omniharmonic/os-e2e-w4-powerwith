        {
          "id": "blk_nzpvagkvg9",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Pre-order and receive the Orientation.",
            "level": "h2",
            "size": "auto",
            "eyebrow": "PRE-ORDER GIFT"
          },
          "variant": "eyebrow-rule",
          "column": 0
        },
        {
          "id": "blk_bk4wp838p7",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A companion for your first reading. Power With asks a great deal of its reader. The Orientation helps you take it in and keep it close."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0
        },
        {
          "id": "blk_p5td8vxrjx",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "INSIDE THE ORIENTATION",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "The framework on one page. Power, power over and power with."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "The ten principles at a glance, with the practice from each."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "How to read the book. Straight through once, then back to the principles one at a time."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "The five measures of success, set as a reflection to return to."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "The pause, the single practice beneath all ten."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "column": 0
        },
        {
          "id": "blk_mxmj4xcfd5",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Order from any retailer, then enter your order number. The Orientation arrives by email."
                    }
                  ]
                }
              ]
            }
          },
          "column": 1
        },
