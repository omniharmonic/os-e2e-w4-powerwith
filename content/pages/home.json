          "fields": {
            "buttonStyle": "primary",
            "cardStyle": "columns",
            "cards": [
              {
                "body": "It comes with the title. It can compel compliance and direct behavior. Compliance is its ceiling.",
                "emphasis": false,
                "icon": "none",
                "label": "POSITIONAL AUTHORITY"
              },
              {
                "body": "It accumulates through trust. People bring you problems early. They tell you what they tell no one else. They commit to decisions they did not make, and they stay when they could leave.",
                "emphasis": true,
                "icon": "none",
                "label": "RELATIONAL AUTHORITY"
              }
            ],
            "closing": "The inner work is the leadership work.",
            "closingSize": "large",
            "ground": "olive",
            "headline": "The authority people follow by choice.",
            "headlineSize": "standard",
            "intro": "",
            "kicker": "FOR LEADERS"
